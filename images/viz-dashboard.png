<svg width="800" height="450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad1)"/>
  <text x="50%" y="40%" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">
    Data Visualization
  </text>
  <text x="50%" y="50%" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.8">
    Dashboard
  </text>
  <g transform="translate(200, 250)">
    <rect x="0" y="60" width="40" height="40" fill="white" opacity="0.7" rx="4"/>
    <rect x="50" y="40" width="40" height="60" fill="white" opacity="0.7" rx="4"/>
    <rect x="100" y="20" width="40" height="80" fill="white" opacity="0.7" rx="4"/>
    <rect x="150" y="50" width="40" height="50" fill="white" opacity="0.7" rx="4"/>
    <rect x="200" y="30" width="40" height="70" fill="white" opacity="0.7" rx="4"/>
    <rect x="250" y="10" width="40" height="90" fill="white" opacity="0.7" rx="4"/>
    <rect x="300" y="45" width="40" height="55" fill="white" opacity="0.7" rx="4"/>
  </g>
</svg>