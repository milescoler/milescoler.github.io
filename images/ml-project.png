<svg width="800" height="450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad2)"/>
  <text x="50%" y="40%" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">
    Machine Learning
  </text>
  <text x="50%" y="50%" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" opacity="0.8">
    Classification Model
  </text>
  <g transform="translate(250, 250)">
    <circle cx="50" cy="30" r="8" fill="white" opacity="0.7"/>
    <circle cx="80" cy="50" r="8" fill="white" opacity="0.7"/>
    <circle cx="120" cy="40" r="8" fill="white" opacity="0.7"/>
    <circle cx="150" cy="60" r="8" fill="white" opacity="0.7"/>
    <circle cx="180" cy="35" r="8" fill="white" opacity="0.7"/>
    <circle cx="210" cy="55" r="8" fill="white" opacity="0.7"/>
    <circle cx="240" cy="45" r="8" fill="white" opacity="0.7"/>
    <circle cx="270" cy="50" r="8" fill="white" opacity="0.7"/>
    <line x1="50" y1="30" x2="80" y2="50" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="80" y1="50" x2="120" y2="40" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="120" y1="40" x2="150" y2="60" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="150" y1="60" x2="180" y2="35" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="180" y1="35" x2="210" y2="55" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="210" y1="55" x2="240" y2="45" stroke="white" stroke-width="2" opacity="0.5"/>
    <line x1="240" y1="45" x2="270" y2="50" stroke="white" stroke-width="2" opacity="0.5"/>
  </g>
</svg>